<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept in the project root on purpose. The SDK merges this file during publish
  (filling in the aspNetCore processPath/arguments/hostingModel) instead of
  generating one from scratch, so the <security> block below survives.

  Without that block the site answers 401 with a Basic-auth prompt: this host
  disables anonymous authentication at the server level and expects each site's
  web.config to re-enable it.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="true" />
          <basicAuthentication enabled="false" />
          <windowsAuthentication enabled="false" />
        </authentication>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled: flip to true to capture startup crashes in logs/stdout_*.log -->
      <aspNetCore processPath=".\MdfTracker.Api.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
